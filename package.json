  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n frontend,backend \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs && vite build",
    "start:server": "node server-dist/server/index.js",
    "lint": "oxlint",
    "test": "tsx --test src/game/engine.test.ts src/game/avatars.test.ts server/media.test.ts",
    "test:load:online": "node scripts/online-load-test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^18.0.7",
    "mediasoup": "^3.29.0",
    "mediasoup-client": "^3.24.5",
    "mysql2": "^3.24.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "mediasoup@3.29.0": true
  }
